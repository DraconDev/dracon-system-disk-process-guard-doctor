[Unit]
Description=Dracon System Guard - Proactive disk space monitoring and cleanup
Documentation=https://github.com/DraconDev/dracon-utilities
After=network.target

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
# NixOS-optimized PATH. On non-NixOS distributions, customize or use
# PassEnvironment=PATH after running `systemctl --user import-environment PATH`.
Environment=PATH=%h/.local/bin:/run/wrappers/bin:%h/.local/share/flatpak/exports/bin:/var/lib/flatpak/exports/bin:%h/.nix-profile/bin:/nix/profile/bin:%h/.local/state/nix/profile/bin:/etc/profiles/per-user/%u/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin
ExecStart=%h/.local/bin/dracon-system guard daemon
# ADDED 2026-09-29 (DECIDE #2 follow-up): without an ExecReload,
# `systemctl --user reload` had no handler and the documented SIGHUP reload
# path could not be invoked through systemd. SIGHUP is the reload signal the
# guard already handles; this just makes it reachable from the service
# manager. It is NOT a freshness mechanism: the daemon re-reads the policy
# file every pass, but only to pick up `links` entries — `[guard]` and
# `[storage]` come from the copy the daemon holds, so a threshold change
# needs this signal (or a restart) to take effect.
#
# /bin/sh, not /bin/kill: this unit is NixOS-targeted but also serves plain
# distros, and on NixOS /bin contains only `sh` — `systemd-analyze verify`
# rejects `/bin/kill` there with "Command /bin/kill is not executable". /bin/sh
# is universal, and `kill` is a POSIX shell builtin, so no PATH lookup is
# involved at all. The NixOS store path would verify but is absent off NixOS.
ExecReload=/bin/sh -c 'kill -HUP $MAINPID'
# Do not restart clean policy-disabled exits; restart crashes and failures.
Restart=on-failure
RestartSec=10
# 78 = EX_CONFIG for malformed/unreadable startup policy; 2 = CLI usage error.
RestartPreventExitStatus=2 78

# Keep any intentionally relative policy paths stable for the user service.
WorkingDirectory=%h

# Run as the user who owns the service
# For system-wide deployment, create a dedicated user
# User=dracon-guard
# Group=dracon-guard

# Resource limits
MemoryMax=250M
CPUQuota=20%
TasksMax=64

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# clean_tmp targets the host /tmp (the policy default), so do not create a
# service-private temporary namespace. ProtectSystem remains strict; /tmp is
# the explicit writable exception needed for age-based top-level cleanup.
# CHANGED 2026-09-20 (space audit): %h/.local/state/nix is writable so
# nix-env can lock the user profile for generation pruning (without it
# every nix cleanup failed with "Read-only file system" under
# ProtectHome=read-only). Deployed units predating the PrivateTmp=false
# fix MUST be reinstalled — with PrivateTmp=true the guard "cleans" an
# empty private namespace while host /tmp (86 GiB on 2026-09-20) grows.
# CHANGED 2026-09-27 (audit F94): %h/.local/share is writable so the
# example policy's log_dirs (~/.local/share/opencode/log) is reachable —
# without it truncate_log_file's write-mode open fails EROFS under
# ProtectSystem=strict and auto_truncate_logs reclaims nothing. /var/log
# is deliberately NOT granted: an unprivileged user service cannot
# truncate it under this hardening, so shipping it in log_dirs only
# produced a permanent "failed to truncate" warning.
ReadWritePaths=%h/.dracon %h/Dev %h/.local/state/dracon %h/.local/share %h/.local/share/Trash %h/.cargo %h/.cache %h/.npm %h/.local/state/nix /tmp
PrivateTmp=false

# Kernel-level sandboxing (all certain — these daemons never use these privileges)
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
# CHANGED 2026-08-25 (v0.112.39): grant CAP_SYS_NICE so
# auto_renice_on_memory actually runs — without it the guard could lower
# an offender's priority but never restore it, so it emitted
# "renice mitigation disabled" and did nothing during pressure.
# Scoped to exactly this one capability; NoNewPrivileges stays on.
# (Adopted into the repo 2026-09-20; previously live-only edit.)
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
RestrictNamespaces=true

# Syscall allowlist — returns EPERM instead of SIGSYS for safe discovery
SystemCallFilter=@system-service

[Install]
WantedBy=default.target
