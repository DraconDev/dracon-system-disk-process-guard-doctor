# Shipped by dracon-utilities (audit M8, 2026-10-02): previously live-only.
# install.sh copies this to ~/.config/systemd/user/ and enables the timer.
[Unit]
Description=Dracon system guard watchdog (restart daemon if stopped)
Documentation=https://github.com/DraconDev/dracon-utilities
After=timers.target

[Service]
Type=oneshot
ExecStart=%h/.dracon/system-notify/dracon-system-guard-watchdog.sh
# Hard timeout: the check is a couple of systemctl calls, never slow.
TimeoutStartSec=15
# Capture output for debugging
StandardOutput=journal
StandardError=journal
