+        fs::create_dir_all(&roots.proc).unwrap();
+        fs::create_dir_all(&roots.locks).unwrap();
+        fs::write(roots.proc.join("uptime"), "3600.0 0.0\n").unwrap();
+        Self {
+            temp,
+            roots,
